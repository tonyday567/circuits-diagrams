cabal-version: 3.0
name: circuits-diagrams
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: control
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-diagrams#readme
bug-reports: https://github.com/tonyday567/circuits-diagrams/issues
synopsis: String-diagram syntax and SVG rendering for circuits
description:
  User-facing grammars built on @circuits@: string diagrams, spans, the Int
  construction, and differential polynomials as syntactic surfaces over the
  semantic machinery in @circuits@, plus dark house-palette SVG rendering of
  the compact-closed string-diagram DSL via @chart-svg@.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-diagrams

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.Diagram
    Circuit.Diagram.Hyper
    Circuit.Mermaid
    Circuit.Poly.DiffP
    Circuit.Poly.Int
    Circuit.Poly.Span
    Circuit.Poly.StringDiagram
    Strings.Svg
    Strings.Svg.Examples
    Strings.Svg.Layout
    Strings.Svg.Palette
    Strings.Svg.Render

  build-depends:
    base >=4.20 && <5,
    bytestring >=0.11 && <0.13,
    chart-svg >=0.8 && <0.9,
    circuits >=0.3 && <0.4,
    circuits-diff >=0.1 && <0.2,
    circuits-mat >=0.1 && <0.2,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    numhask >=0.14 && <0.15,
    optics-core >=0.4 && <0.5,
    text >=1.2 && <2.2,

executable circuits-diagrams-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    base >=4.20 && <5,
    chart-svg >=0.8 && <0.9,
    circuits >=0.3 && <0.4,
    circuits-diagrams,
    circuits-diff,

executable render-examples
  import: ghc-options-stanza
  default-language: GHC2024
  main-is: render-examples.hs
  hs-source-dirs: app
  build-depends:
    base >=4.20 && <5,
    circuits-diagrams,
    optparse-applicative >=0.17 && <0.20,
